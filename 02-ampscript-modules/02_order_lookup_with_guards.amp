02_order_lookup_with_guards

We have to show Order number and order amount to the targeted or sendable customers. So pull the specific data of Rowset by Using LOOKUPROWS.

%%[
VAR @subkey, @orderNum, @orderAmt, @rowCount, @rows, @row
SET @subKey = AttributeValue("SubscriberKey")
SET @rows = LOOKUPROWS("Order_DE", "Subscriberkey", @subKey)
SET @rowCount = ROWCOUNT(@rows)
IF @rowCount > 0 THEN
SET @row = Row(@rows, 1)
SET @orderNum = Field(@row, "OrderNumber")
SET @orderAmt = Field(@row, "OrderAmt")
ELSE
SET @orderNum = "None"
SET @orderAmt = 0
ENDIF
]%%
********************************************************************************

Check the Susbcribers subscription for check renwal Date and Plan name


%%[
VAR @subKey, @row, @rows, @rowCount, @planName, @expiryDate
SET @subKey = AttributeValue("SubscriberKey")
SET @rows = LOOKUPROWS("Subscription_DE", "SubscriberKey", @subKey)
SET @rowCount = ROWCOUNT(@rows)
IF @rowcCount > 0 THEN
SET @row = Row(@rows, 1)
SET @planName = Field(@row, "PlanName")
SET @expiryDate = Field(@row, "ExpiryDate")
ELSE
SET @planName = "None"
SET @ExpiryDate = "None"
]%%
